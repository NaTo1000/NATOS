# NATOS environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# The .env file is listed in .gitignore and must NEVER be committed to source
# control.
#
# Usage with Docker:
#   docker run --env-file .env -p 5000:5000 natos
#
# Usage with docker-compose:
#   docker-compose up          (docker-compose.yml reads .env automatically)
# ─────────────────────────────────────────────────────────────────────────────

# Flask session secret – generate with: python -c "import secrets; print(secrets.token_hex(32))"
NATOS_SECRET_KEY=INSECURE-EXAMPLE-VALUE-REPLACE-BEFORE-USE

# Application credentials (used by the NATOS runtime, not the OS)
NATOS_USERNAME=your-username-here
NATOS_PASSWORD=change-me-use-a-strong-password

# Set to "true" to enable TLS/SSL termination inside the container
NATOS_USE_SSL=false

# Set to "true" only after reading the End User Licence Agreement
NATOS_ACCEPT_EULA=false

# Anthropic API key – required only when the AI tuning agent is enabled
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=
